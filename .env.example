# Policy: "program" = compile the goal once into subgoals, then tactics + resolver + Laya actor, no LLM per step;
# "planner" = local LLM planner every step + resolver + Laya actor; "laya" = Laya alone on the raw goal;
# anything else uses the hosted TypeSafe API (needs TYPESAFE_API_KEY).
POLICY_BACKEND=program
# Model for the one compile call per task (defaults to TEXT_MODEL). Pick it with scripts/bench_compile.py.
# COMPILER_MODEL=mlx-community/Qwen3-1.7B-4bit
# Where compiled programs and learned search templates are cached (default ~/.cache/laya-browser).
# LAYA_CACHE_DIR=artifacts/cache
# 0 recompiles every goal (use for the first run of an evaluation, so each run pays for its own compile).
# LAYA_PROGRAM_CACHE=1
# planner backend only: actor confidence below which the planner chooses among the actor's top five.
ACTOR_TAU=0.5
# 1 only with a checkpoint trained on context-annotated options (Phase C).
ACTOR_CONTEXT=0
LAYA_CHECKPOINT=checkpoints/laya_browser_mind2web
# Local text model: mlx_lm.server --model mlx-community/Qwen3-4B-Instruct-2507-4bit --port 8080
TEXT_MODEL_BASE_URL=http://127.0.0.1:8080/v1
TEXT_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
# Drive a throwaway Chrome started with --remote-debugging-port=9333 --user-data-dir=<tmp>, never your real profile.
BU_CDP_URL=http://127.0.0.1:9333
BH_TELEMETRY=0
